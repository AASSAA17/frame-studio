# Local-only infrastructure. Replace all credentials before any deployment.
POSTGRES_USER=frame
POSTGRES_PASSWORD=local-frame-change-me
POSTGRES_DB=frame_studio
DATABASE_URL=postgresql://frame:local-frame-change-me@127.0.0.1:55432/frame_studio?schema=public
# Dedicated disposable database. Integration tests never use DATABASE_URL.
TEST_DATABASE_URL=postgresql://frame:local-frame-change-me@127.0.0.1:55432/frame_studio_test?schema=public
# Separate disposable browser-test database; never point this at customer data.
E2E_DATABASE_URL=postgresql://frame:local-frame-change-me@127.0.0.1:55432/frame_studio_e2e?schema=public
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
PAYMENT_MODE=test
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=FRAME STUDIO <studio@frame.test>
# Only for the explicit local admin:create command; never NEXT_PUBLIC variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Reserved for the private-file phase; uploads are not enabled in stage 1.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=frame-private
S3_ACCESS_KEY=frame-local
S3_SECRET_KEY=local-storage-change-me
# Set only behind a trusted proxy that overwrites this header.
TRUSTED_IP_HEADER=
