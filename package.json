{
  "name": "frame-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "vitest run tests/domain",
    "test:unit": "vitest run tests/domain",
    "test:integration": "vitest run tests/integration",
    "test:migration": "tsx scripts/verify-stage2-migration.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test:unit",
    "format": "prettier --write src tests scripts/*.ts *.ts *.mjs *.json"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.3.1",
    "better-auth": "1.7.12",
    "dotenv": "18.0.9",
    "lucide-react": "1.61.0",
    "luxon": "3.7.2",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
